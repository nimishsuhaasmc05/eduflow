# Edu-Flow Environment Configuration Example

SECRET_KEY=your-secret-key
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

DATABASE_URL=postgresql+psycopg://eduflow_user:YOUR_POSTGRES_PASSWORD@localhost:5432/eduflow

REDIS_URL=redis://localhost:6379/0

OPENAI_API_KEY=

